# MongoDB Atlas (or any Mongo instance) connection string
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority

# Database name
DB_NAME=portfolio

# Port the API runs on locally
PORT=3000

# Restrict CORS to your live site once deployed, e.g. https://muhammadtayyab.dev
ALLOWED_ORIGIN=*
